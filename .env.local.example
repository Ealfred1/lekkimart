# Copy this file to .env.local and fill in your own values.

# Cloudinary (free tier is fine) — used for signed, server-side image uploads
# via the Cloudinary Node SDK (src/app/api/images/upload/route.ts). The API
# secret only ever lives on the server, never in the browser.
# Find this on your Cloudinary dashboard home page ("API Environment variable"),
# or build it as cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Optional: override the Chowdeck API base URL (defaults to
# https://api.chowdeck.com/merchant if unset). Only needed if Chowdeck gives you
# a sandbox/staging URL to test against.
# CHOWDECK_BASE_URL=

# Optional: override the Glovo Partner API base URL (defaults to
# https://glovo.partner.deliveryhero.io). Point this at Glovo's sandbox
# (https://sandbox.partner.deliveryhero.io) to test before going live —
# strongly recommended given how much of the Glovo integration is unverified,
# see the README's "Glovo" section.
# GLOVO_BASE_URL=

# Optional: locale code for Glovo product titles/descriptions. Defaults to
# "en" — unconfirmed for non-English markets, see src/lib/glovo.ts.
# GLOVO_LOCALE=
